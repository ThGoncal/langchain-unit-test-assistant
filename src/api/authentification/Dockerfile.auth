FROM python:3.13-slim

WORKDIR /app

COPY src/api/authentification/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# On copie tout src/ (pas seulement authentification/) : main importe
# api.authentification.auth, et il est plus simple de garder une structure
# de fichiers identique dans les deux images plutôt que de la fragmenter.
COPY src/ ./

EXPOSE 8001
CMD ["uvicorn", "api.authentification.auth:app", "--host", "0.0.0.0", "--port", "8001"]