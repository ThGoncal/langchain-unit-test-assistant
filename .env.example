# JWT (JSON Web Token) parameters

# JWT_SECRET généré par la commande openssl rand -hex 32 pour ne plus avoir l'erreur:
# InsecureKeyLengthWarning: The HMAC key is 6 bytes long, which is below the minimum recommended length of 32 bytes for SHA256. See RFC 7518 Section 3.2.

JWT_SECRET = <YOUR_SECRET>
JWT_ALGORITHM = "HS256"
JWT_EXPIRATION_SECONDS = 600

# GROQ
GROQ_API_KEY=<YOUR_API_KEY>
CHAT_MODEL="groq:openai/gpt-oss-120b"
USER_AGENT="langchain-course-bot/1.0"

#LANGSMITH
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=<YOUR_API_KEY>
LANGSMITH_PROJECT=assistant_document
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com # Indispensable sinon pas de tracing dans LangSmith